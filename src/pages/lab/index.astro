---
import Base from '../../layouts/Base.astro';

// Neue Experimente: Seite unter src/pages/lab/ anlegen und hier eintragen.
const experiments = [
	{
		href: '/lab/game-of-life',
		title: "Conway's Game of Life",
		summary: 'Zellulärer Automat auf einem Canvas – klicken zum Zeichnen.',
		tech: ['TypeScript', 'Canvas'],
	},
];
---

<Base title="Lab" description="Experimente und Spielereien.">
	<h1>Lab</h1>
	<p class="muted">Mein Playground: kleine Experimente, Prototypen und Dinge, die ich ausprobiere.</p>
	<div class="grid">
		{
			experiments.map((e) => (
				<a class="card experiment" href={e.href}>
					<h3>{e.title}</h3>
					<p class="muted">{e.summary}</p>
					<ul class="tags">{e.tech.map((t) => <li>{t}</li>)}</ul>
				</a>
			))
		}
	</div>
</Base>

<style>
	.experiment {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.experiment:hover {
		border-color: var(--accent);
	}

	h3 {
		margin: 0 0 0.5rem;
	}

	p {
		margin: 0;
	}
</style>
